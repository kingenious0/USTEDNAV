{
  "name": "USTED Nav - Campus Navigation",
  "short_name": "USTED Nav",
  "description": "Offline campus navigation and room finder for USTED Kumasi.",
  "developer": {
    "name": "KINGENIOUS"
  },
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait-primary",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "categories": [
    "education",
    "navigation"
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=app.ustednav.twa",
      "id": "app.ustednav.twa"
    }
  ],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "auto"
  },
  "scope_extensions": [
    {
      "origin": "https://www.ustednav.app"
    },
    {
      "origin": "https://ustednav.app"
    }
  ],
  "share_target": {
    "action": "/map.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/map.html",
      "name": "Campus Geographic Data",
      "accept": {
        "application/geo+json": [
          ".geojson"
        ],
        "application/json": [
          ".json"
        ]
      }
    }
  ],
  "edge_side_panel": {
    "preferred_width": 480
  },
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Campus Map",
      "short_name": "Map",
      "description": "Open live interactive 2D and 3D campus navigation map",
      "url": "/map.html",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Room & Staff Search",
      "short_name": "Search",
      "description": "Search lecturers, departments, lecture halls, and room numbers",
      "url": "/map.html?search=true",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/screenshot-mobile.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "USTED Nav Mobile Campus Map & Route Navigation"
    },
    {
      "src": "/screenshots/screenshot-desktop.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "USTED Nav Desktop Map, Route Explorer & Building Finder"
    }
  ]
}
